# Speaking coach providers (server-side only; never expose these keys to Expo).
AZURE_API_KEY=
AZURE_SPEECH_REGION=southeastasia
GEMINI_API_KEY=
SPEAKING_COACH_MODEL=gemini-3.5-flash-lite
SPEAKING_COACH_EVALUATION_TIMEOUT_SECONDS=60
SPEAKING_COACH_THINKING_LEVEL=minimal

# Protects POST /api/internal/speaking/cleanup. Use a long random value and
# store the same value in the scheduler's secret store.
SPEAKING_COACH_CLEANUP_SECRET=
SPEAKING_COACH_AUDIO_RETENTION_HOURS=24
SPEAKING_COACH_DETAILED_RETENTION_DAYS=90
SPEAKING_COACH_HISTORY_RETENTION_DAYS=365
SPEAKING_COACH_PROCESSING_STALE_MINUTES=10
SPEAKING_COACH_CLEANUP_BATCH_SIZE=100
